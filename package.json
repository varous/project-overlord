{
  "name": "project-overlord",
  "version": "0.0.0",
  "private": true,
  "description": "Spatial event-site planning platform for Clockwork AV (Kolkata).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b && tsc -p packages/geo-core/tsconfig.test.json && tsc -p apps/web/tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build:web": "npm run build -w @overlord/web"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.2"
  }
}
