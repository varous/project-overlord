{
  "$description": "2D/3D Editor design tokens — mirrors the Figma 'Theme' (Light/Dark) and 'Metrics' variable collections. W3C-ish token format for Style Dictionary / Tokens Studio.",
  "color": {
    "bg": {
      "app":      { "$type": "color", "$value": { "light": "#F4F4F2", "dark": "#1B1C1E" } },
      "panel":    { "$type": "color", "$value": { "light": "#FFFFFF", "dark": "#242628" } },
      "panelAlt": { "$type": "color", "$value": { "light": "#F1F1EF", "dark": "#2E3033" } },
      "canvas":   { "$type": "color", "$value": { "light": "#EDEDEA", "dark": "#171819" } },
      "menubar":  { "$type": "color", "$value": { "light": "#FFFFFF", "dark": "#202224" } }
    },
    "border": {
      "default": { "$type": "color", "$value": { "light": "#E6E6E2", "dark": "#37393C" } },
      "subtle":  { "$type": "color", "$value": { "light": "#EFEFEC", "dark": "#2C2E30" } }
    },
    "text": {
      "primary":   { "$type": "color", "$value": { "light": "#17181A", "dark": "#F4F4F3" } },
      "secondary": { "$type": "color", "$value": { "light": "#83858A", "dark": "#9C9EA3" } },
      "tertiary":  { "$type": "color", "$value": { "light": "#B3B5B8", "dark": "#6A6C70" } }
    },
    "icon": { "default": { "$type": "color", "$value": { "light": "#4A4C50", "dark": "#C6C7C9" } } },
    "accent": {
      "default": { "$type": "color", "$value": { "light": "#17181A", "dark": "#F2F2F1" }, "$description": "Ink accent — buttons, active segments, tab underlines" },
      "soft":    { "$type": "color", "$value": { "light": "#EAEAE7", "dark": "#35373A" }, "$description": "Active tool/row background" },
      "textOn":  { "$type": "color", "$value": { "light": "#FFFFFF", "dark": "#17181A" } }
    },
    "selection": {
      "default": { "$type": "color", "$value": { "light": "#2F7CFF", "dark": "#5E96FF" }, "$description": "Canvas object selection ONLY — never in chrome" },
      "soft":    { "$type": "color", "$value": { "light": "#E8F0FB", "dark": "#263346" } }
    },
    "danger": { "default": { "$type": "color", "$value": { "light": "#D93A2F", "dark": "#E5766D" } } },
    "chip": {
      "pink":   { "$type": "color", "$value": { "light": "#F6E3E1", "dark": "#453230" } },
      "blue":   { "$type": "color", "$value": { "light": "#E3EBF8", "dark": "#2C3442" } },
      "orange": { "$type": "color", "$value": { "light": "#F3ECDD", "dark": "#42392B" } },
      "purple": { "$type": "color", "$value": { "light": "#E9E6F5", "dark": "#363044" } }
    },
    "canvasGrid": { "$type": "color", "$value": { "light": "#DDDDD9", "dark": "#2A2C2E" } },
    "axis": {
      "x": { "$type": "color", "$value": "#FF6B57" },
      "y": { "$type": "color", "$value": "#3DBE68" },
      "z": { "$type": "color", "$value": "#4A79FF" }
    }
  },
  "spacing": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "xl": { "$type": "dimension", "$value": "24px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "6px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "lg": { "$type": "dimension", "$value": "12px" },
    "full": { "$type": "dimension", "$value": "999px" }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": "0 1px 2px rgba(20,20,20,.08)" },
    "md": { "$type": "shadow", "$value": "0 3px 10px rgba(20,20,20,.10)" },
    "lg": { "$type": "shadow", "$value": "0 8px 24px rgba(20,20,20,.12), 0 2px 6px rgba(20,20,20,.06)" }
  },
  "typography": {
    "fontFamily": { "$type": "fontFamily", "$value": "Inter, -apple-system, 'Segoe UI', sans-serif" },
    "display": { "$type": "typography", "$value": { "fontWeight": 700, "fontSize": "24px", "lineHeight": "30px" } },
    "heading": { "$type": "typography", "$value": { "fontWeight": 600, "fontSize": "16px", "lineHeight": "22px" } },
    "title":   { "$type": "typography", "$value": { "fontWeight": 600, "fontSize": "13px", "lineHeight": "18px" } },
    "body":    { "$type": "typography", "$value": { "fontWeight": 400, "fontSize": "12.5px", "lineHeight": "18px" } },
    "label":   { "$type": "typography", "$value": { "fontWeight": 500, "fontSize": "11.5px", "lineHeight": "16px" } },
    "caption": { "$type": "typography", "$value": { "fontWeight": 500, "fontSize": "10px", "lineHeight": "14px" } },
    "micro":   { "$type": "typography", "$value": { "fontWeight": 600, "fontSize": "9px", "lineHeight": "12px", "letterSpacing": "0.04em", "textTransform": "uppercase" } }
  },
  "layout": {
    "menubarHeight":   { "$type": "dimension", "$value": "40px" },
    "viewbarHeight":   { "$type": "dimension", "$value": "44px" },
    "modebarHeight":   { "$type": "dimension", "$value": "36px" },
    "statusbarHeight": { "$type": "dimension", "$value": "32px" },
    "leftPanelWidth":  { "$type": "dimension", "$value": "296px" },
    "toolRailWidth":   { "$type": "dimension", "$value": "48px" },
    "rightPanelWidth": { "$type": "dimension", "$value": "300px" }
  },
  "rules": {
    "$description": [
      "1. Ink (accent.default) is the only emphasis color in UI chrome: primary buttons, active segments, tab underlines, badges of emphasis.",
      "2. selection.default (blue) appears ONLY inside the canvas: selection outlines, handles, active data-bar field. Never use it on chrome controls.",
      "3. Active states in panels use accent.soft backgrounds, not color.",
      "4. Chip colors are for identity/status only (layer dots, avatars, status pills) — always with text.primary on top.",
      "5. Hairline borders: border.default between shell regions, border.subtle inside panels.",
      "6. Floating overlays (toolbar, data bar, tooltips, menus) get shadow.lg on bg.panel with a border.default hairline.",
      "7. All measurements snap to the 4px grid (spacing scale)."
    ]
  }
}
