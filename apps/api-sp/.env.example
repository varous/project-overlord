# ---------------------------------------------------------------------------
# Copy to .env for local development. NEVER commit .env.
# In production every one of these is set in Render → Environment.
# The Google client secret must never be pasted into chat, a ticket, or a commit.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# Postgres. connection_limit is deliberate - see docs/06-stack-review.md #8
DATABASE_URL=postgresql://showplan:showplan@localhost:5432/showplan?connection_limit=5

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only ID tokens carrying this hosted-domain claim are accepted. Security boundary.
ALLOWED_HD=clockwork-av.com

# Session cookie signing key. openssl rand -hex 32
SESSION_SECRET=

# Cloudflare R2 (S3-compatible). Free egress — see docs/11-deployment-cost-plan.md
# and docs/RUNNING-LOCALLY.md § R2. Upload fails closed until these are set
# (API names the missing keys; never logs values).
#
# R2_ACCOUNT_ID         Cloudflare dashboard → R2 → Overview (Account ID)
# R2_ACCESS_KEY_ID      R2 → Manage R2 API Tokens → create token (Access Key ID)
# R2_SECRET_ACCESS_KEY  same token dialog (Secret Access Key) — treat like a password
# R2_BUCKET             bucket name for THIS environment (local: showplan-dev)
# R2_ENDPOINT           R2 → bucket → Settings → S3 API endpoint
#                       (https://<accountid>.r2.cloudflarestorage.com)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=showplan-dev
R2_ENDPOINT=

# Optional
SENTRY_DSN=
