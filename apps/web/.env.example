# Copy to .env.local and fill in for Google Photorealistic 3D Tiles.
# Leave empty to run with the GOOGLE_3D stack disabled. Never commit a real key.
VITE_GOOGLE_MAPS_KEY=

# Optional ArcGIS API key for Esri World Imagery. Leave empty to use Cesium's bundled
# development token (fine for local dev only). Never commit a real key.
VITE_ARCGIS_API_KEY=
